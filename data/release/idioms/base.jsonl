{"guid": "M01_001", "source": {"language": "en", "expression": "bite the bullet"}, "meaning": "to force oneself to endure something unpleasant that cannot be avoided", "equivalents": {"lt": [{"expression": "sukąsti dantis", "kind": "idiomatic", "literalGloss": "to clench one's teeth"}], "zh": [{"expression": "咬紧牙关", "kind": "idiomatic", "literalGloss": "to clench the teeth tightly"}], "fr": [{"expression": "serrer les dents", "kind": "idiomatic", "literalGloss": "to clench the teeth"}], "es": [{"expression": "hacer de tripas corazón", "kind": "idiomatic", "literalGloss": "to make a heart out of guts"}], "de": [{"expression": "in den sauren Apfel beißen", "kind": "idiomatic", "literalGloss": "to bite into the sour apple"}], "it": [{"expression": "stringere i denti", "kind": "idiomatic", "literalGloss": "to clench the teeth"}]}, "register": "informal", "difficulty_level": -1}
{"guid": "M01_002", "source": {"language": "en", "expression": "throw in the towel"}, "meaning": "to admit defeat and stop trying", "equivalents": {"lt": [{"expression": "numesti rankšluostį", "kind": "idiomatic", "literalGloss": "to throw down the towel", "usageNote": "Borrowed from the same boxing image as the English."}, {"expression": "pasiduoti", "kind": "paraphrase", "literalGloss": "to give up"}], "zh": [{"expression": "认输", "kind": "paraphrase", "literalGloss": "to admit defeat", "usageNote": "No boxing-derived idiom is conventional; this is the ordinary expression."}], "fr": [{"expression": "jeter l'éponge", "kind": "idiomatic", "literalGloss": "to throw the sponge"}], "es": [{"expression": "tirar la toalla", "kind": "idiomatic", "literalGloss": "to throw the towel"}], "de": [{"expression": "das Handtuch werfen", "kind": "idiomatic", "literalGloss": "to throw the towel"}], "it": [{"expression": "gettare la spugna", "kind": "idiomatic", "literalGloss": "to throw the sponge"}]}, "register": "informal", "difficulty_level": -1}
{"guid": "M01_003", "source": {"language": "zh", "expression": "画蛇添足"}, "meaning": "to ruin something by adding what is unnecessary", "equivalents": {"en": [{"expression": "gild the lily", "kind": "near_equivalent", "usageNote": "Shares the sense of spoiling by over-adding, but lacks the Chinese story's note of outright foolishness."}], "lt": [{"expression": "perlenkti lazdą", "kind": "near_equivalent", "literalGloss": "to bend the stick too far"}], "fr": [{"expression": "en faire trop", "kind": "paraphrase", "literalGloss": "to do too much of it"}], "de": [{"expression": "des Guten zu viel tun", "kind": "idiomatic", "literalGloss": "to do too much of the good"}]}, "usageNote": "From a fable in which a man loses a drawing contest by adding feet to his snake.", "register": "literary", "difficulty_level": -1}
{"guid": "M01_004", "source": {"language": "fr", "expression": "poser un lapin"}, "meaning": "to fail to show up for an arranged meeting", "equivalents": {"en": [{"expression": "stand someone up", "kind": "idiomatic"}], "lt": [{"expression": "neateiti į susitikimą", "kind": "paraphrase", "literalGloss": "to not come to the meeting"}], "zh": [{"expression": "放鸽子", "kind": "idiomatic", "literalGloss": "to release a pigeon"}], "es": [{"expression": "dar plantón", "kind": "idiomatic", "literalGloss": "to give a standing"}], "de": [{"expression": "jemanden versetzen", "kind": "idiomatic", "literalGloss": "to displace someone"}], "it": [{"expression": "dare buca", "kind": "idiomatic", "literalGloss": "to give a hole"}]}, "usageNote": "Literally \"to place a rabbit\"; the origin of the image is disputed.", "register": "informal", "difficulty_level": -1}
