{"guid": "C99_001", "pos_type": "conjunction", "pos_subtype": "conjunction_other", "concept_label": "and", "concept_definition": "used to connect words, phrases, clauses, or sentences to indicate addition or combination (e.g., \"apples and oranges\", \"She sang and he danced\").", "translations": {"en": "and", "lt": "ir", "zh": "和", "zh-tw": "和", "fr": "et", "es": "y", "es-419": "y", "de": "und", "it": "e", "nl": "en", "pt": "e", "pt-br": "e", "sv": "och", "vi": "và", "ja": "そして", "ko": "그리고", "sw": "na"}, "difficulty_level": 6}
