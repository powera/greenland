{"guid": "N78_001", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "kingdom (divine realm)", "concept_definition": "In Christianity, the spiritual realm in which God reigns.", "translations": {"en": "kingdom", "lt": "Dievo karalystė", "zh": "上帝的国", "fr": "royaume de Dieu", "es": "reino de Dios", "es-419": "reino de Dios"}, "difficulty_level": 281, "disambiguation": {"en": "divine realm"}, "sense_prominence": "common"}
{"guid": "N78_002", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "deity", "concept_definition": "A god or goddess, especially one worshiped as part of a religion.", "translations": {"en": "deity", "lt": "dievybė", "zh": "神祇", "fr": "divinité", "es": "deidad", "es-419": "deidad"}, "difficulty_level": 391, "sense_prominence": "very_common"}
{"guid": "N78_003", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "goddess", "concept_definition": "A female god or deity, especially one worshiped in a religion or mythology.", "translations": {"en": "goddess", "lt": "deivė", "zh": "女神", "fr": "déesse", "es": "diosa", "es-419": "diosa"}, "difficulty_level": 223, "sense_prominence": "very_common"}
{"guid": "N78_004", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "pantheon (gods)", "concept_definition": "A pantheon is all the gods of a particular religion or mythology considered collectively.", "translations": {"en": "pantheon", "lt": "panteonas", "zh": "众神体系", "fr": "panthéon", "es": "panteón", "es-419": "panteón"}, "difficulty_level": 1060, "disambiguation": {"en": "gods"}, "sense_prominence": "very_common"}
{"guid": "N78_005", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "creator", "concept_definition": "God, regarded as the being who made the world and everything in it.", "translations": {"en": "creator", "lt": "Kūrėjas", "zh": "造物主", "fr": "Créateur", "es": "Creador", "es-419": "Creador"}, "difficulty_level": 1311, "sense_prominence": "common"}
{"guid": "N78_006", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "eve", "concept_definition": "The first woman, according to the Bible, and the wife of Adam.", "translations": {"en": "eve", "lt": "Ieva", "zh": "夏娃", "fr": "Ève", "es": "Eva", "es-419": "Eva"}, "difficulty_level": 1000, "sense_prominence": "common"}
{"guid": "N78_007", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "immortal", "concept_definition": "A being believed to live forever, especially a god or goddess.", "translations": {"en": "immortal", "lt": "nemirtingasis", "zh": "不朽者", "fr": "immortel", "es": "inmortal", "es-419": "inmortal"}, "difficulty_level": 1060, "sense_prominence": "common"}
{"guid": "N78_008", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "spirit", "concept_definition": "The nonphysical part of a person that is often believed to survive after death; the soul.", "translations": {"en": "spirit", "lt": "dvasia", "zh": "灵魂", "fr": "esprit", "es": "espíritu", "es-419": "espíritu"}, "difficulty_level": 281, "sense_prominence": "very_common"}
{"guid": "N78_009", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "spirit", "concept_definition": "A supernatural being, especially one thought to haunt a place or appear to the living.", "translations": {"en": "spirit", "lt": "dvasia", "zh": "鬼魂", "fr": "esprit", "es": "espíritu", "es-419": "espíritu"}, "difficulty_level": 1399, "sense_prominence": "common"}
{"guid": "N78_010", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "ghost", "concept_definition": "The spirit of a dead person, especially one believed to appear to the living.", "translations": {"en": "ghost", "lt": "vaiduoklis", "zh": "鬼魂", "fr": "fantôme", "es": "fantasma", "es-419": "fantasma"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N78_011", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "angel", "concept_definition": "A spiritual being believed to serve God, often depicted as a messenger or as having wings.", "translations": {"en": "angel", "lt": "angelas", "zh": "天使", "fr": "ange", "es": "ángel", "es-419": "ángel"}, "difficulty_level": 281, "sense_prominence": "very_common"}
{"guid": "N78_012", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "devil", "concept_definition": "In Christian theology and folklore, the supreme evil spirit who opposes God and tempts people to do wrong; Satan.", "translations": {"en": "devil", "lt": "velnias", "zh": "魔鬼", "fr": "diable", "es": "diablo", "es-419": "diablo"}, "difficulty_level": 1065, "sense_prominence": "very_common"}
{"guid": "N78_013", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "heaven", "concept_definition": "The place or state believed in many religions to be the home of God or the gods and the destination of the good after death.", "translations": {"en": "heaven", "lt": "dangus", "zh": "天堂", "fr": "paradis", "es": "cielo", "es-419": "cielo"}, "difficulty_level": 281, "sense_prominence": "very_common"}
{"guid": "N78_014", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "demon", "concept_definition": "An evil supernatural being, especially one regarded as serving or opposing a god or tempting people to do wrong.", "translations": {"en": "demon", "lt": "demonas", "zh": "恶魔", "fr": "démon", "es": "demonio", "es-419": "demonio"}, "difficulty_level": 1065, "sense_prominence": "very_common"}
{"guid": "N78_015", "pos_type": "noun", "pos_subtype": "spiritual_being", "concept_label": "hell", "concept_definition": "In some religions, the place or state where the dead are punished or suffer eternally.", "translations": {"en": "hell", "lt": "pragaras", "zh": "地狱", "fr": "enfer", "es": "infierno", "es-419": "infierno"}, "difficulty_level": 1060, "sense_prominence": "very_common"}
