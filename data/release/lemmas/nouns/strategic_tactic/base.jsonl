{"guid": "N62_013", "pos_type": "noun", "pos_subtype": "strategic_tactic", "concept_label": "ladder (go)", "concept_definition": "A repeating diagonal sequence in go in which one player chases an opposing stone or group toward the edge of the board, capturing it if it cannot escape.", "translations": {"en": "ladder", "zh": "征子"}, "difficulty_level": 1211, "disambiguation": {"en": "go"}, "sense_prominence": "rare"}
{"guid": "N62_014", "pos_type": "noun", "pos_subtype": "strategic_tactic", "concept_label": "net (go)", "concept_definition": "In go, a loose surrounding move that traps an opposing stone by preventing it from escaping, even though the stone is not directly adjacent to the surrounding stones.", "translations": {"en": "net", "zh": "枷"}, "difficulty_level": 1211, "disambiguation": {"en": "go"}, "sense_prominence": "rare"}
{"guid": "N62_015", "pos_type": "noun", "pos_subtype": "strategic_tactic", "concept_label": "gote", "concept_definition": "In Go, a move or sequence that leaves the opponent with the initiative because it does not force an immediate reply.", "translations": {"en": "gote", "zh": "后手"}, "difficulty_level": 1211, "sense_prominence": "rare"}
{"guid": "N62_016", "pos_type": "noun", "pos_subtype": "strategic_tactic", "concept_label": "finesse (bridge)", "concept_definition": "In a card game, an attempt to win a trick by playing a card that is not the highest, relying on the chance that higher cards have already been played or are held by a particular opponent.", "translations": {"en": "finesse"}, "difficulty_level": 1214, "disambiguation": {"en": "bridge"}, "sense_prominence": "rare"}
{"guid": "N62_017", "pos_type": "noun", "pos_subtype": "strategic_tactic", "concept_label": "attack (cycling)", "concept_definition": "A sudden increase in speed by a cyclist to break away from other riders during a race.", "translations": {"en": "attack", "fr": "attaque", "es": "ataque", "es-419": "ataque"}, "difficulty_level": 1218, "disambiguation": {"en": "cycling"}, "sense_prominence": "rare"}
