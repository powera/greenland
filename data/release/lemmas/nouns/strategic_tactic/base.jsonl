{"guid": "N62_019", "pos_type": "noun", "pos_subtype": "strategic_tactic", "concept_label": "drafting (cycling)", "concept_definition": "The tactic of riding close behind another cyclist to reduce air resistance and save effort.", "translations": {"en": "drafting", "zh": "跟车", "fr": "aspiration", "es": "rebufo", "es-419": "rebufo"}, "difficulty_level": 1218, "disambiguation": {"en": "cycling"}, "sense_prominence": "rare"}
