{"guid": "N38_001", "pos_type": "noun", "pos_subtype": "plant_part", "concept_label": "leaf", "concept_definition": "A flat, typically green plant organ attached to a stem or branch, where photosynthesis and gas exchange occur.", "translations": {"en": "leaf", "lt": "lapas", "zh": "叶子", "fr": "feuille", "es": "hoja", "de": "Blatt", "it": "foglia", "nl": "blad", "pt": "folha", "sv": "blad", "vi": "lá", "ja": "葉", "ko": "잎", "sw": "jani"}, "difficulty_level": 8}
{"guid": "N38_002", "pos_type": "noun", "pos_subtype": "plant_part", "concept_label": "root", "concept_definition": "The part of a plant that typically grows underground, anchoring the plant and absorbing water and nutrients from the soil.", "translations": {"en": "root", "lt": "šaknis", "zh": "根", "fr": "racine", "es": "raíz", "de": "Wurzel", "it": "radice", "nl": "wortel", "pt": "raiz", "sv": "rot", "vi": "rễ", "ja": "根", "ko": "뿌리", "sw": "mzizi"}, "difficulty_level": 15}
