{"guid": "N34_001", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "meter", "concept_definition": "A unit of length in the International System of Units (SI), equal to 100 centimeters or approximately 39.37 inches; the base unit for measuring distance.", "translations": {"en": "meter", "lt": "metras", "zh": "米", "fr": "mètre", "es": "metro", "de": "Meter", "it": "metro", "nl": "meter", "pt": "metro", "sv": "meter", "vi": "mét", "ja": "メートル", "ko": "미터", "sw": "mita"}, "difficulty_level": 30}
{"guid": "N34_002", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "centimeter", "concept_definition": "a unit of length equal to one hundredth of a meter (0.01 m), commonly used to measure short distances", "translations": {"en": "centimeter", "lt": "centimetras", "zh": "厘米", "fr": "centimètre", "es": "centímetro", "de": "Zentimeter", "it": "centimetro", "nl": "centimeter", "pt": "centímetro", "sv": "centimeter", "vi": "xentimét", "ja": "センチメートル", "ko": "센티미터", "sw": "sentimita"}, "difficulty_level": 30}
{"guid": "N34_003", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "kilometer", "concept_definition": "a unit of length in the metric system equal to 1,000 meters (about 0.621 miles).", "translations": {"en": "kilometer", "lt": "kilometras", "zh": "公里", "fr": "kilomètre", "es": "kilómetro", "de": "Kilometer", "it": "chilometro", "nl": "kilometer", "pt": "quilômetro", "sv": "kilometer", "vi": "kilômét", "ja": "キロメートル", "ko": "킬로미터", "sw": "kilomita"}, "difficulty_level": 30}
{"guid": "N34_004", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "mile", "concept_definition": "a unit of linear distance equal to 5,280 feet (approximately 1,609.34 metres); used chiefly in the United States and the United Kingdom", "translations": {"en": "mile", "lt": "mylia", "zh": "英里", "fr": "mile", "es": "milla", "de": "Meile", "it": "miglio", "nl": "mijl", "pt": "milha", "sv": "mil", "vi": "dặm", "ja": "マイル", "ko": "마일", "sw": "maili"}, "difficulty_level": 30}
{"guid": "N34_005", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "gram", "concept_definition": "a unit of mass in the metric system equal to one thousandth of a kilogram (0.001 kg), commonly used to measure small weights", "translations": {"en": "gram", "lt": "gramas", "zh": "克", "fr": "gramme", "es": "gramo", "de": "Gramm", "it": "grammo", "nl": "gram", "pt": "grama", "sv": "gram", "vi": "gam", "ja": "グラム", "ko": "그램", "sw": "gramu"}, "difficulty_level": 30}
{"guid": "N34_006", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "kilogram", "concept_definition": "A unit of mass in the International System of Units (SI) equal to one thousand grams, approximately 2.20462 pounds.", "translations": {"en": "kilogram", "lt": "kilogramas", "zh": "公斤", "fr": "kilogramme", "es": "kilogramo", "de": "Kilogramm", "it": "chilogrammo", "nl": "kilogram", "pt": "quilograma", "sv": "kilogram", "vi": "kilôgam", "ja": "キログラム", "ko": "킬로그램", "sw": "kilogramu"}, "difficulty_level": 30}
{"guid": "N34_007", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "liter", "concept_definition": "a metric unit of capacity equal to 1 cubic decimetre (1 L = 1 dm³), commonly used for measuring volumes of liquids", "translations": {"en": "liter", "lt": "litras", "zh": "升", "fr": "litre", "es": "litro", "de": "Liter", "it": "litro", "nl": "liter", "pt": "litro", "sv": "liter", "vi": "lít", "ja": "リットル", "ko": "리터", "sw": "lita"}, "difficulty_level": 30}
{"guid": "N34_008", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "milliliter", "concept_definition": "a metric unit of volume equal to one thousandth of a liter (0.001 L)", "translations": {"en": "milliliter", "lt": "mililitras", "zh": "毫升", "fr": "millilitre", "es": "mililitro", "de": "Milliliter", "it": "millilitro", "nl": "milliliter", "pt": "mililitro", "sv": "milliliter", "vi": "mililít", "ja": "ミリリットル", "ko": "밀리리터", "sw": "mililita"}, "difficulty_level": 30}
{"guid": "N34_009", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "degree", "concept_definition": "a unit of measurement for temperature or angles (e.g., degrees Celsius, degrees of arc)", "translations": {"en": "degree", "lt": "laipsnis", "zh": "度", "fr": "degré", "es": "grado", "de": "Grad", "it": "grado", "nl": "graad", "pt": "grau", "sv": "grad", "vi": "độ", "ja": "度", "ko": "도", "sw": "digrii"}, "difficulty_level": 30}
{"guid": "N34_010", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "celsius", "concept_definition": "a unit of temperature on the Celsius scale, equal to one hundredth of the interval between the freezing and boiling points of water under standard conditions (0 °C = freezing point, 100 °C = boiling point); also used as the name of the scale itself", "translations": {"en": "celsius", "lt": "celsijus", "zh": "摄氏度", "fr": "celsius", "es": "celsius", "de": "Celsius", "it": "celsius", "nl": "celsius", "pt": "celsius", "sv": "celsius", "vi": "độ C", "ja": "摂氏", "ko": "섭씨", "sw": "selsiyasi"}, "difficulty_level": 30}
{"guid": "N34_011", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "fahrenheit", "concept_definition": "A scale for measuring temperature in which water freezes at 32 degrees and boils at 212 degrees under standard atmospheric pressure; temperatures are expressed in degrees Fahrenheit (°F).", "translations": {"en": "fahrenheit", "lt": "farenheitas", "zh": "华氏度", "fr": "fahrenheit", "es": "fahrenheit", "de": "Fahrenheit", "it": "fahrenheit", "nl": "fahrenheit", "pt": "fahrenheit", "sv": "fahrenheit", "vi": "độ F", "ja": "華氏", "ko": "화씨", "sw": "farenheti"}, "difficulty_level": 30}
