{"guid": "N34_009", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "degree", "concept_definition": "a unit of measurement for temperature or angles (e.g., degrees Celsius, degrees of arc)", "translations": {"en": "degree", "lt": "laipsnis", "zh": "度", "fr": "degré", "es": "grado", "de": "Grad", "it": "grado", "nl": "graad", "pt": "grau", "sv": "grad", "vi": "độ", "ja": "度", "ko": "도", "sw": "digrii"}, "difficulty_level": 224}
{"guid": "N34_010", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "celsius", "concept_definition": "a unit of temperature on the Celsius scale, equal to one hundredth of the interval between the freezing and boiling points of water under standard conditions (0 °C = freezing point, 100 °C = boiling point); also used as the name of the scale itself", "translations": {"en": "celsius", "lt": "celsijus", "zh": "摄氏度", "fr": "celsius", "es": "celsius", "de": "Celsius", "it": "celsius", "nl": "celsius", "pt": "celsius", "sv": "celsius", "vi": "độ C", "ja": "摂氏", "ko": "섭씨", "sw": "selsiyasi"}, "difficulty_level": 224}
{"guid": "N34_011", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "fahrenheit", "concept_definition": "A scale for measuring temperature in which water freezes at 32 degrees and boils at 212 degrees under standard atmospheric pressure; temperatures are expressed in degrees Fahrenheit (°F).", "translations": {"en": "fahrenheit", "lt": "farenheitas", "zh": "华氏度", "fr": "fahrenheit", "es": "fahrenheit", "de": "Fahrenheit", "it": "fahrenheit", "nl": "fahrenheit", "pt": "fahrenheit", "sv": "fahrenheit", "vi": "độ F", "ja": "華氏", "ko": "화씨", "sw": "farenheti"}, "difficulty_level": 224}
{"guid": "N34_012", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "ton", "concept_definition": "A unit of weight equal to 2,000 pounds (907.2 kilograms) in the United States and Canada.", "translations": {"en": "ton", "lt": "tona", "zh": "吨", "fr": "tonne", "es": "tonelada", "es-419": "tonelada"}, "difficulty_level": 1050, "sense_prominence": "very_common"}
{"guid": "N34_013", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "fee", "concept_definition": "A payment charged for a service or privilege.", "translations": {"en": "fee", "lt": "mokestis", "zh": "费用", "fr": "frais", "es": "tarifa", "es-419": "tarifa"}, "difficulty_level": 224, "sense_prominence": "very_common"}
{"guid": "N34_014", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "tablespoon", "concept_definition": "A unit of volume equal to the amount held by a standard tablespoon, commonly three teaspoons or about 15 milliliters.", "translations": {"en": "tablespoon", "lt": "valgomojo šaukšto tūris", "zh": "汤匙", "fr": "cuillère à soupe", "es": "cucharada", "es-419": "cucharada"}, "difficulty_level": 224, "sense_prominence": "very_common"}
{"guid": "N34_015", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "teaspoonful", "concept_definition": "An amount of a substance that a teaspoon can hold, typically about 5 milliliters.", "translations": {"en": "teaspoonful", "lt": "šaukštelis", "zh": "一茶匙", "fr": "cuillerée à café", "es": "cucharadita", "es-419": "cucharadita"}, "difficulty_level": 1090, "sense_prominence": "very_common"}
{"guid": "N34_016", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "tablespoonful", "concept_definition": "An amount of a substance that fills a tablespoon, typically about 15 milliliters.", "translations": {"en": "tablespoonful", "lt": "šaukštas", "zh": "一汤匙", "fr": "cuillerée à soupe", "es": "cucharada", "es-419": "cucharada"}, "difficulty_level": 1090, "sense_prominence": "very_common"}
{"guid": "N34_017", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "quart", "concept_definition": "A unit of liquid capacity equal to one quarter of a gallon; in the United States, 32 fluid ounces (about 0.946 liters), and in the United Kingdom, 40 fluid ounces (about 1.136 liters).", "translations": {"en": "quart", "lt": "kvorta", "zh": "夸脱", "fr": "quart", "es": "cuarto de galón", "es-419": "cuarto de galón"}, "difficulty_level": 1090, "sense_prominence": "very_common"}
{"guid": "N34_018", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "spoonful", "concept_definition": "An amount of something that a spoon can hold or that is held in a spoon.", "translations": {"en": "spoonful", "lt": "šaukštas", "zh": "一勺", "fr": "cuillerée", "es": "cucharada", "es-419": "cucharada"}, "difficulty_level": 1090, "sense_prominence": "very_common"}
{"guid": "N34_019", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "saltspoonful", "concept_definition": "The amount of salt that a saltspoon can hold.", "translations": {"en": "saltspoonful", "lt": "druskos šaukštelio kiekis", "zh": "盐匙量", "fr": "quantité contenue dans une cuillère à sel", "es": "cantidad de sal que cabe en una cucharilla", "es-419": "cantidad de sal que cabe en una cucharita"}, "difficulty_level": 1090, "sense_prominence": "rare"}
{"guid": "N34_020", "pos_type": "noun", "pos_subtype": "unit_of_measurement", "concept_label": "teacupful", "concept_definition": "The amount of a substance that a teacup can hold.", "translations": {"en": "teacupful", "lt": "arbatos puodelio talpa", "zh": "一茶杯", "fr": "tasse de thé", "es": "taza de té", "es-419": "taza de té"}, "difficulty_level": 1090, "sense_prominence": "uncommon"}
