{"guid": "N77_001", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "electron", "concept_definition": "A stable subatomic particle with a negative electric charge, found outside the nucleus of an atom and involved in electricity, chemical bonding, and radiation.", "translations": {"en": "electron", "lt": "elektronas", "zh": "电子", "fr": "électron", "es": "electrón", "es-419": "electrón", "de": "Elektron", "it": "elettrone", "pt": "eletrão", "vi": "electron", "ko": "전자"}, "difficulty_level": 314, "sense_prominence": "very_common"}
{"guid": "N77_002", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "ion", "concept_definition": "An atom or molecule that has gained or lost one or more electrons and therefore carries an electric charge.", "translations": {"en": "ion", "lt": "jonas", "zh": "离子", "fr": "ion", "es": "ion", "es-419": "ion", "de": "Ion", "it": "ione", "pt": "ião", "vi": "ion", "ko": "이온"}, "difficulty_level": 314, "sense_prominence": "very_common"}
{"guid": "N77_003", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "molecule", "concept_definition": "The smallest unit of a chemical compound that retains the compound’s chemical properties, consisting of two or more atoms bonded together.", "translations": {"en": "molecule", "lt": "molekulė", "zh": "分子", "fr": "molécule", "es": "molécula", "es-419": "molécula", "de": "Molekül", "it": "molecola", "pt": "molécula", "vi": "phân tử", "ko": "분자"}, "difficulty_level": 314, "sense_prominence": "very_common"}
{"guid": "N77_004", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "subatomic particle", "concept_definition": "A constituent of matter or energy studied in physics, such as an electron, proton, or photon.", "translations": {"en": "subatomic particle", "lt": "subatominė dalelė", "zh": "亚原子粒子", "fr": "particule subatomique", "es": "partícula subatómica", "es-419": "partícula subatómica"}, "difficulty_level": 381, "sense_prominence": "common"}
{"guid": "N77_005", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "atom", "concept_definition": "The smallest unit of a chemical element that retains the element’s chemical properties, consisting of a nucleus surrounded by electrons.", "translations": {"en": "atom", "lt": "atomas", "zh": "原子", "fr": "atome", "es": "átomo", "es-419": "átomo"}, "difficulty_level": 223, "sense_prominence": "very_common"}
{"guid": "N77_006", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "neutron", "concept_definition": "A subatomic particle with no electric charge, found in the nuclei of most atoms and slightly heavier than a proton.", "translations": {"en": "neutron", "lt": "neutronas", "zh": "中子", "fr": "neutron", "es": "neutrón", "es-419": "neutrón"}, "difficulty_level": 381, "sense_prominence": "very_common"}
{"guid": "N77_007", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "photon", "concept_definition": "A photon is a quantum of electromagnetic radiation, understood as a discrete packet of energy.", "translations": {"en": "photon", "lt": "fotonas", "zh": "光子", "fr": "photon", "es": "fotón", "es-419": "fotón"}, "difficulty_level": 1050, "sense_prominence": "very_common"}
{"guid": "N77_008", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "quark", "concept_definition": "A quark is any of a group of elementary particles that combine to form composite particles such as protons and neutrons.", "translations": {"en": "quark", "lt": "kvarkas", "zh": "夸克", "fr": "quark", "es": "quark", "es-419": "quark"}, "difficulty_level": 1050, "sense_prominence": "very_common"}
{"guid": "N77_009", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "neutrino", "concept_definition": "An electrically neutral, extremely light elementary particle that interacts mainly through the weak nuclear force and gravity.", "translations": {"en": "neutrino", "lt": "neutrinas", "zh": "中微子", "fr": "neutrino", "es": "neutrino", "es-419": "neutrino"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_010", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "culture (laboratory)", "concept_definition": "A culture is the growth of microorganisms, cells, or tissues in a prepared medium under controlled conditions, or the resulting growth.", "translations": {"en": "culture", "lt": "kultūra", "zh": "培养物", "fr": "culture", "es": "cultivo", "es-419": "cultivo"}, "difficulty_level": 1399, "disambiguation": {"en": "laboratory"}, "sense_prominence": "common"}
{"guid": "N77_011", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "micro-organisms", "concept_definition": "A microorganism is a living organism too small to be seen clearly without a microscope.", "translations": {"en": "micro-organisms", "lt": "mikroorganizmai", "zh": "微生物", "fr": "micro-organismes", "es": "microorganismos", "es-419": "microorganismos"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_012", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "boson", "concept_definition": "A particle with integer spin that obeys Bose–Einstein statistics.", "translations": {"en": "boson", "lt": "bozonas", "zh": "玻色子", "fr": "boson", "es": "bosón", "es-419": "bosón"}, "difficulty_level": 1399, "sense_prominence": "common"}
{"guid": "N77_013", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "fermion", "concept_definition": "A fermion is a particle with half-integer spin that obeys the Pauli exclusion principle, including electrons, quarks, and neutrinos.", "translations": {"en": "fermion", "lt": "fermionas", "zh": "费米子", "fr": "fermion", "es": "fermión", "es-419": "fermión"}, "difficulty_level": 1399, "sense_prominence": "common"}
{"guid": "N77_014", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "dinoflagellate", "concept_definition": "A dinoflagellate is a mostly single-celled aquatic organism, often classified as an alga or protist, typically characterized by two flagella.", "translations": {"en": "dinoflagellate", "lt": "dinoflagelatas", "zh": "甲藻", "fr": "dinoflagellé", "es": "dinoflagelado", "es-419": "dinoflagelado"}, "difficulty_level": 1399, "sense_prominence": "common"}
{"guid": "N77_015", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "yeast", "concept_definition": "A microscopic fungus that grows by budding or division and is used to ferment sugars, especially in making bread, beer, and wine.", "translations": {"en": "yeast", "lt": "mielės", "zh": "酵母", "fr": "levure", "es": "levadura", "es-419": "levadura"}, "difficulty_level": 1095, "sense_prominence": "very_common"}
{"guid": "N77_016", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "bacteria", "concept_definition": "Microscopic single-celled organisms that lack a nucleus; some cause disease, while many are harmless or beneficial.", "translations": {"en": "bacteria", "lt": "bakterijos", "zh": "细菌", "fr": "bactéries", "es": "bacterias", "es-419": "bacterias"}, "difficulty_level": 1015, "sense_prominence": "very_common"}
{"guid": "N77_017", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "bacterium", "concept_definition": "A microscopic single-celled organism that lacks a nucleus and may live in many environments; some bacteria cause disease, while others are harmless or beneficial.", "translations": {"en": "bacterium", "lt": "bakterija", "zh": "细菌", "fr": "bactérie", "es": "bacteria", "es-419": "bacteria"}, "difficulty_level": 1015, "sense_prominence": "very_common"}
{"guid": "N77_018", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "chromosome", "concept_definition": "A threadlike structure in the nucleus of a cell, made of DNA and proteins, that carries genes and transmits hereditary information.", "translations": {"en": "chromosome", "lt": "chromosoma", "zh": "染色体", "fr": "chromosome", "es": "cromosoma", "es-419": "cromosoma"}, "difficulty_level": 1015, "sense_prominence": "very_common"}
{"guid": "N77_019", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "genome", "concept_definition": "The complete set of genetic material in an organism, cell, or virus, including all of its genes and other DNA or RNA sequences.", "translations": {"en": "genome", "lt": "genomas", "zh": "基因组", "fr": "génome", "es": "genoma", "es-419": "genoma"}, "difficulty_level": 1015, "sense_prominence": "very_common"}
{"guid": "N77_020", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "neuron", "concept_definition": "A specialized nerve cell that receives and transmits information through electrical and chemical signals.", "translations": {"en": "neuron", "lt": "neuronas", "zh": "神经元", "fr": "neurone", "es": "neurona", "es-419": "neurona"}, "difficulty_level": 1015, "sense_prominence": "very_common"}
{"guid": "N77_021", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "pathogen", "concept_definition": "A microorganism or other biological agent that causes disease in a host, such as a bacterium, virus, fungus, or parasite.", "translations": {"en": "pathogen", "lt": "patogenas", "zh": "病原体", "fr": "agent pathogène", "es": "patógeno", "es-419": "patógeno"}, "difficulty_level": 1015, "sense_prominence": "very_common"}
{"guid": "N77_022", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "flora", "concept_definition": "The microorganisms, especially bacteria, that live in a particular part of the body or environment; often used in terms such as gut flora.", "translations": {"en": "flora", "lt": "mikroflora", "zh": "菌群", "fr": "flore", "es": "flora", "es-419": "flora"}, "difficulty_level": 1025, "sense_prominence": "common"}
{"guid": "N77_023", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "allele", "concept_definition": "One of two or more alternative forms of a gene that occupy the same position on a chromosome and may produce different versions of a trait.", "translations": {"en": "allele", "lt": "alelis", "zh": "等位基因", "fr": "allèle", "es": "alelo", "es-419": "alelo"}, "difficulty_level": 1056, "sense_prominence": "common"}
{"guid": "N77_024", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "chloroplasts", "concept_definition": "Organelles in plant and algal cells that contain chlorophyll and carry out photosynthesis.", "translations": {"en": "chloroplasts", "lt": "chloroplastai", "zh": "叶绿体", "fr": "chloroplastes", "es": "cloroplastos", "es-419": "cloroplastos"}, "difficulty_level": 1056, "sense_prominence": "very_common"}
{"guid": "N77_025", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "mitochondria", "concept_definition": "Small structures inside the cells of most organisms that generate much of the energy the cells use through cellular respiration; they also perform other cellular functions.", "translations": {"en": "mitochondria", "lt": "mitochondrijos", "zh": "线粒体", "fr": "mitochondries", "es": "mitocondrias", "es-419": "mitocondrias"}, "difficulty_level": 1056, "sense_prominence": "very_common"}
{"guid": "N77_026", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "mould", "concept_definition": "A furry growth of microscopic fungi that forms on damp or decaying organic matter, or the fungi themselves.", "translations": {"en": "mould", "lt": "pelėsis", "zh": "霉菌", "fr": "moisissure", "es": "moho", "es-419": "moho"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_027", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "nucleus", "concept_definition": "The dense central region of an atom, containing protons and, in most atoms, neutrons.", "translations": {"en": "nucleus", "lt": "atomo branduolys", "zh": "原子核", "fr": "noyau atomique", "es": "núcleo atómico", "es-419": "núcleo atómico"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_028", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "nucleus", "concept_definition": "A membrane-bound structure in a eukaryotic cell that contains most of the cell’s genetic material and controls many of its activities.", "translations": {"en": "nucleus", "lt": "ląstelės branduolys", "zh": "细胞核", "fr": "noyau cellulaire", "es": "núcleo celular", "es-419": "núcleo celular"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_029", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "variant", "concept_definition": "A genetic form of a virus or other organism that differs from other forms through changes in its genetic material.", "translations": {"en": "variant", "lt": "atmaina", "zh": "变异株", "fr": "variant", "es": "variante", "es-419": "variante"}, "difficulty_level": 1399, "sense_prominence": "common"}
{"guid": "N77_030", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "germ", "concept_definition": "A microorganism, especially a disease-causing bacterium or virus; in everyday use, any tiny organism that can cause infection.", "translations": {"en": "germ", "lt": "gemalas", "zh": "病菌", "fr": "microbe", "es": "germen", "es-419": "germen"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_031", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "gene", "concept_definition": "A unit of heredity consisting of a sequence of DNA that influences a particular characteristic or contributes to the production of a functional molecule.", "translations": {"en": "gene", "lt": "genas", "zh": "基因", "fr": "gène", "es": "gen", "es-419": "gen"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
