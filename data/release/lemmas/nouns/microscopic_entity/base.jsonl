{"guid": "N77_001", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "electron", "concept_definition": "A stable subatomic particle with a negative electric charge, found outside the nucleus of an atom and involved in electricity, chemical bonding, and radiation.", "translations": {"en": "electron", "lt": "elektronas", "zh": "电子", "fr": "électron", "es": "electrón", "es-419": "electrón", "de": "Elektron", "it": "elettrone", "pt": "eletrão", "vi": "electron", "ko": "전자"}, "difficulty_level": 314, "sense_prominence": "very_common"}
{"guid": "N77_002", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "ion", "concept_definition": "An atom or molecule that has gained or lost one or more electrons and therefore carries an electric charge.", "translations": {"en": "ion", "lt": "jonas", "zh": "离子", "fr": "ion", "es": "ion", "es-419": "ion", "de": "Ion", "it": "ione", "pt": "ião", "vi": "ion", "ko": "이온"}, "difficulty_level": 314, "sense_prominence": "very_common"}
{"guid": "N77_003", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "molecule", "concept_definition": "The smallest unit of a chemical compound that retains the compound’s chemical properties, consisting of two or more atoms bonded together.", "translations": {"en": "molecule", "lt": "molekulė", "zh": "分子", "fr": "molécule", "es": "molécula", "es-419": "molécula", "de": "Molekül", "it": "molecola", "pt": "molécula", "vi": "phân tử", "ko": "분자"}, "difficulty_level": 314, "sense_prominence": "very_common"}
{"guid": "N77_004", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "subatomic particle", "concept_definition": "A constituent of matter or energy studied in physics, such as an electron, proton, or photon.", "translations": {"en": "subatomic particle", "lt": "subatominė dalelė", "zh": "亚原子粒子", "fr": "particule subatomique", "es": "partícula subatómica", "es-419": "partícula subatómica"}, "difficulty_level": 1399, "sense_prominence": "common"}
{"guid": "N77_005", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "atom", "concept_definition": "The smallest unit of a chemical element that retains the element’s chemical properties, consisting of a nucleus surrounded by electrons.", "translations": {"en": "atom", "lt": "atomas", "zh": "原子", "fr": "atome", "es": "átomo", "es-419": "átomo"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_006", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "neutron", "concept_definition": "A subatomic particle with no electric charge, found in the nuclei of most atoms and slightly heavier than a proton.", "translations": {"en": "neutron", "lt": "neutronas", "zh": "中子", "fr": "neutron", "es": "neutrón", "es-419": "neutrón"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_007", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "photon", "concept_definition": "A photon is a quantum of electromagnetic radiation, understood as a discrete packet of energy.", "translations": {"en": "photon", "lt": "fotonas", "zh": "光子", "fr": "photon", "es": "fotón", "es-419": "fotón"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_008", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "quark", "concept_definition": "A quark is any of a group of elementary particles that combine to form composite particles such as protons and neutrons.", "translations": {"en": "quark", "lt": "kvarkas", "zh": "夸克", "fr": "quark", "es": "quark", "es-419": "quark"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_009", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "neutrino", "concept_definition": "An electrically neutral, extremely light elementary particle that interacts mainly through the weak nuclear force and gravity.", "translations": {"en": "neutrino", "lt": "neutrinas", "zh": "中微子", "fr": "neutrino", "es": "neutrino", "es-419": "neutrino"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_010", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "culture (laboratory)", "concept_definition": "A culture is the growth of microorganisms, cells, or tissues in a prepared medium under controlled conditions, or the resulting growth.", "translations": {"en": "culture", "lt": "kultūra", "zh": "培养物", "fr": "culture", "es": "cultivo", "es-419": "cultivo"}, "difficulty_level": 1399, "disambiguation": {"en": "laboratory"}, "sense_prominence": "common"}
{"guid": "N77_011", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "micro-organisms", "concept_definition": "A microorganism is a living organism too small to be seen clearly without a microscope.", "translations": {"en": "micro-organisms", "lt": "mikroorganizmai", "zh": "微生物", "fr": "micro-organismes", "es": "microorganismos", "es-419": "microorganismos"}, "difficulty_level": 1399, "sense_prominence": "very_common"}
{"guid": "N77_012", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "boson", "concept_definition": "A particle with integer spin that obeys Bose–Einstein statistics.", "translations": {"en": "boson", "lt": "bozonas", "zh": "玻色子", "fr": "boson", "es": "bosón", "es-419": "bosón"}, "difficulty_level": 1399, "sense_prominence": "common"}
{"guid": "N77_013", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "fermion", "concept_definition": "A fermion is a particle with half-integer spin that obeys the Pauli exclusion principle, including electrons, quarks, and neutrinos.", "translations": {"en": "fermion", "lt": "fermionas", "zh": "费米子", "fr": "fermion", "es": "fermión", "es-419": "fermión"}, "difficulty_level": 1399, "sense_prominence": "common"}
{"guid": "N77_014", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "dinoflagellate", "concept_definition": "A dinoflagellate is a mostly single-celled aquatic organism, often classified as an alga or protist, typically characterized by two flagella.", "translations": {"en": "dinoflagellate", "lt": "dinoflagelatas", "zh": "甲藻", "fr": "dinoflagellé", "es": "dinoflagelado", "es-419": "dinoflagelado"}, "difficulty_level": 1399, "sense_prominence": "common"}
