{"guid": "N77_001", "pos_type": "noun", "pos_subtype": "microscopic_entity", "concept_label": "electron", "concept_definition": "A stable subatomic particle with a negative electric charge, found outside the nucleus of an atom and involved in electricity, chemical bonding, and radiation.", "translations": {"en": "electron", "lt": "elektronas", "zh": "电子", "fr": "électron", "es": "electrón", "es-419": "electrón", "de": "Elektron", "it": "elettrone", "pt": "eletrão", "vi": "electron", "ko": "전자"}, "difficulty_level": 314, "sense_prominence": "very_common"}
