{"guid": "N50_001", "pos_type": "noun", "pos_subtype": "communication_information", "concept_label": "word", "concept_definition": "a single distinct meaningful element of speech or writing, typically separated by spaces in writing and by pauses in speech, used to convey meaning or form sentences", "translations": {"en": "word", "lt": "žodis", "zh": "词", "fr": "mot", "es": "palabra", "de": "Wort", "it": "parola", "nl": "woord", "pt": "palavra", "sv": "ord", "vi": "từ", "ja": "言葉", "ko": "단어", "sw": "neno"}, "difficulty_level": 16}
