{"guid": "N55_001", "pos_type": "noun", "pos_subtype": "social_institution", "concept_label": "government", "concept_definition": "The group of people and institutions that make and enforce laws, policies, and decisions for a political unit (such as a country, state, or city).", "translations": {"en": "government", "lt": "vyriausybė", "zh": "政府", "fr": "gouvernement", "es": "gobierno", "de": "Regierung", "it": "governo", "nl": "regering", "pt": "governo", "sv": "regering", "vi": "chính phủ", "ja": "政府", "ko": "정부", "sw": "serikali"}, "difficulty_level": 16}
{"guid": "N55_002", "pos_type": "noun", "pos_subtype": "social_institution", "concept_label": "law", "concept_definition": "A system of rules established by a government or other authority to regulate behavior, enforceable by penalties; a statute, regulation, or body of rules governing a community.", "translations": {"en": "law", "lt": "įstatymas", "zh": "法律", "fr": "loi", "es": "ley", "de": "Gesetz", "it": "legge", "nl": "wet", "pt": "lei", "sv": "lag", "vi": "luật", "ja": "法律", "ko": "법", "sw": "sheria"}, "difficulty_level": 16}
{"guid": "N55_003", "pos_type": "noun", "pos_subtype": "social_institution", "concept_label": "society", "concept_definition": "A community of people living together in an organized way and sharing laws, institutions, traditions, and culture; the aggregate of individuals and groups forming a structured social system.", "translations": {"en": "society", "lt": "visuomenė", "zh": "社会", "fr": "société", "es": "sociedad", "de": "Gesellschaft", "it": "società", "nl": "maatschappij", "pt": "sociedade", "sv": "samhälle", "vi": "xã hội", "ja": "社会", "ko": "사회", "sw": "jamii"}, "difficulty_level": 16}
{"guid": "N55_004", "pos_type": "noun", "pos_subtype": "social_institution", "concept_label": "public", "concept_definition": "the members of the community at large; the people as a whole (e.g., \"He spoke to the public about the policy\").", "translations": {"en": "public", "lt": "visuomenė", "zh": "公众", "fr": "public", "es": "público", "de": "Öffentlichkeit", "it": "pubblico", "nl": "publiek", "pt": "público", "sv": "allmänhet", "vi": "công chúng", "ja": "公衆", "ko": "대중", "sw": "umma"}, "difficulty_level": 16}
