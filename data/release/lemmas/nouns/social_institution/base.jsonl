{"guid": "N55_001", "pos_type": "noun", "pos_subtype": "social_institution", "concept_label": "government", "concept_definition": "The group of people and institutions that make and enforce laws, policies, and decisions for a political unit (such as a country, state, or city).", "translations": {"en": "government", "lt": "vyriausybė", "zh": "政府", "fr": "gouvernement", "es": "gobierno", "de": "Regierung", "it": "governo", "nl": "regering", "pt": "governo", "sv": "regering", "vi": "chính phủ", "ja": "政府", "ko": "정부", "sw": "serikali"}, "difficulty_level": 16}
{"guid": "N55_002", "pos_type": "noun", "pos_subtype": "social_institution", "concept_label": "law", "concept_definition": "A system of rules established by a government or other authority to regulate behavior, enforceable by penalties; a statute, regulation, or body of rules governing a community.", "translations": {"en": "law", "lt": "įstatymas", "zh": "法律", "fr": "loi", "es": "ley", "de": "Gesetz", "it": "legge", "nl": "wet", "pt": "lei", "sv": "lag", "vi": "luật", "ja": "法律", "ko": "법", "sw": "sheria"}, "difficulty_level": 16}
