{"guid": "N15_001", "pos_type": "noun", "pos_subtype": "chemical_compound", "concept_label": "oxygen", "concept_definition": "A chemical element (symbol O) essential for respiration, making up about 21% of Earth's atmosphere.", "translations": {"en": "oxygen", "lt": "deguonis", "zh": "氧", "fr": "oxygène", "es": "oxígeno", "de": "Sauerstoff", "it": "ossigeno", "nl": "zuurstof", "pt": "oxigênio", "sv": "syre", "vi": "oxy", "ja": "酸素", "ko": "산소", "sw": "oksijeni"}, "difficulty_level": 30}
{"guid": "N15_002", "pos_type": "noun", "pos_subtype": "chemical_compound", "concept_label": "carbon dioxide", "concept_definition": "A colorless gas (CO₂) produced by burning carbon and organic compounds and by respiration, absorbed by plants in photosynthesis.", "translations": {"en": "carbon dioxide", "lt": "anglies dioksidas", "zh": "二氧化碳", "fr": "dioxyde de carbone", "es": "dióxido de carbono", "de": "Kohlendioxid", "it": "anidride carbonica", "nl": "kooldioxide", "pt": "dióxido de carbono", "sv": "koldioxid", "vi": "carbon dioxide", "ja": "二酸化炭素", "ko": "이산화탄소", "sw": "kaboni dioksidi"}, "difficulty_level": 30}
{"guid": "N15_003", "pos_type": "noun", "pos_subtype": "chemical_compound", "concept_label": "lithium", "concept_definition": "A soft, silvery-white chemical element (symbol Li), the lightest metal, used in batteries and psychiatric medication.", "translations": {"en": "lithium", "lt": "litis", "zh": "锂", "fr": "lithium", "es": "litio", "de": "Lithium", "it": "litio", "nl": "lithium", "pt": "lítio", "sv": "litium", "vi": "liti", "ja": "リチウム", "ko": "리튬", "sw": "lithiamu"}, "difficulty_level": -1}
{"guid": "N15_004", "pos_type": "noun", "pos_subtype": "chemical_compound", "concept_label": "hydrogen", "concept_definition": "The lightest and most abundant chemical element (symbol H), a colorless, odorless gas that combines with oxygen to form water.", "translations": {"en": "hydrogen", "lt": "vandenilis", "zh": "氢", "fr": "hydrogène", "es": "hidrógeno", "de": "Wasserstoff", "it": "idrogeno", "nl": "waterstof", "pt": "hidrogênio", "sv": "väte", "vi": "hydro", "ja": "水素", "ko": "수소", "sw": "hidrojeni"}, "difficulty_level": 24}
{"guid": "N15_005", "pos_type": "noun", "pos_subtype": "chemical_compound", "concept_label": "nitrogen", "concept_definition": "A chemical element (symbol N) that is a colorless, odorless gas making up about 78% of Earth's atmosphere, essential for plant growth.", "translations": {"en": "nitrogen", "lt": "azotas", "zh": "氮", "fr": "azote", "es": "nitrógeno", "de": "Stickstoff", "it": "azoto", "nl": "stikstof", "pt": "nitrogênio", "sv": "kväve", "vi": "nitơ", "ja": "窒素", "ko": "질소", "sw": "nitrojeni"}, "difficulty_level": 24}
{"guid": "N15_006", "pos_type": "noun", "pos_subtype": "chemical_compound", "concept_label": "ammonia", "concept_definition": "A pungent, colorless gas (NH₃) composed of nitrogen and hydrogen, widely used in fertilizers, cleaning products, and industrial chemistry.", "translations": {"en": "ammonia", "lt": "amoniakas", "zh": "氨", "fr": "ammoniac", "es": "amoníaco", "de": "Ammoniak", "it": "ammoniaca", "nl": "ammoniak", "pt": "amônia", "sv": "ammoniak", "vi": "amoniac", "ja": "アンモニア", "ko": "암모니아", "sw": "amonia"}, "difficulty_level": 24}
{"guid": "N15_007", "pos_type": "noun", "pos_subtype": "chemical_compound", "concept_label": "methane", "concept_definition": "A colorless, odorless, flammable gas (CH₄) that is the main component of natural gas and a significant greenhouse gas.", "translations": {"en": "methane", "lt": "metanas", "zh": "甲烷", "fr": "méthane", "es": "metano", "de": "Methan", "it": "metano", "nl": "methaan", "pt": "metano", "sv": "metan", "vi": "metan", "ja": "メタン", "ko": "메탄", "sw": "methani"}, "difficulty_level": 24}
{"guid": "N15_008", "pos_type": "noun", "pos_subtype": "chemical_compound", "concept_label": "chlorine", "concept_definition": "A chemical element (symbol Cl) that is a yellow-green, toxic gas with a pungent smell, commonly used to disinfect water and in manufacturing.", "translations": {"en": "chlorine", "lt": "chloras", "zh": "氯", "fr": "chlore", "es": "cloro", "de": "Chlor", "it": "cloro", "nl": "chloor", "pt": "cloro", "sv": "klor", "vi": "clo", "ja": "塩素", "ko": "염소", "sw": "klorini"}, "difficulty_level": 24}
{"guid": "N15_009", "pos_type": "noun", "pos_subtype": "chemical_compound", "concept_label": "acid", "concept_definition": "a chemical substance with a pH below 7 that can dissolve metals and turn litmus paper red.", "translations": {"en": "acid", "lt": "rūgštis", "zh": "酸", "fr": "acide", "es": "ácido", "de": "Säure", "it": "acido", "nl": "zuur", "pt": "ácido", "sv": "syra", "vi": "axit", "ja": "酸", "ko": "산", "sw": "asidi"}, "difficulty_level": 19}
