{"guid": "N36_014", "pos_type": "noun", "pos_subtype": "occupation", "concept_label": "teacher", "concept_definition": "A person whose job is to instruct students in a school or other educational setting; someone who helps others learn by giving lessons or guidance.", "translations": {"en": "teacher", "lt": "mokytojas", "zh": "老師", "fr": "enseignant", "es": "profesor", "de": "Lehrer", "it": "insegnante", "nl": "leraar", "pt": "professor", "sv": "lärare", "vi": "giáo viên", "ja": "教師", "ko": "교사", "sw": "mwalimu"}, "difficulty_level": 5}
{"guid": "N36_015", "pos_type": "noun", "pos_subtype": "occupation", "concept_label": "doctor", "concept_definition": "A person who is trained and licensed to practice medicine and treat patients; a physician.", "translations": {"en": "doctor", "lt": "gydytojas", "zh": "醫生", "fr": "médecin", "es": "médico", "de": "Arzt", "it": "medico", "nl": "arts", "pt": "médico", "sv": "läkare", "vi": "bác sĩ", "ja": "医者", "ko": "의사", "sw": "daktari"}, "difficulty_level": 5}
