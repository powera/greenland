{"guid": "N67_014", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "verb", "concept_definition": "A word that expresses an action, occurrence, state, or relation and typically functions as the predicate of a sentence.", "translations": {"en": "verb", "lt": "veiksmažodis", "zh": "动词", "fr": "verbe", "es": "verbo", "es-419": "verbo", "de": "Verb", "it": "verbo", "pt": "verbo", "vi": "động từ", "ko": "동사"}, "difficulty_level": 329, "sense_prominence": "very_common"}
{"guid": "N67_015", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "affix", "concept_definition": "A letter or group of letters added to the beginning, middle, or end of a word to change its meaning or grammatical function.", "translations": {"en": "affix", "lt": "afiksas", "zh": "词缀", "fr": "affixe", "es": "afijo", "es-419": "afijo", "de": "Affix", "it": "affisso", "pt": "afixo", "vi": "phụ tố", "ko": "접사"}, "difficulty_level": 1110, "sense_prominence": "common"}
