{"guid": "N67_001", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "adverb", "concept_definition": "A word or phrase that modifies a verb, adjective, another adverb, or an entire clause, typically expressing manner, place, time, frequency, degree, or viewpoint.", "translations": {"en": "adverb", "lt": "prieveiksmis", "zh": "副词", "fr": "adverbe", "es": "adverbio", "es-419": "adverbio", "de": "Adverb", "it": "avverbio", "pt": "advérbio", "vi": "trạng từ", "ko": "부사"}, "difficulty_level": 329, "sense_prominence": "very_common"}
{"guid": "N67_002", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "copula", "concept_definition": "A linking verb, especially a form of “be,” that connects a subject with a subject complement.", "translations": {"en": "copula", "lt": "jungtis", "zh": "系词", "fr": "copule", "es": "cópula", "es-419": "cópula", "de": "Kopula", "it": "copula", "pt": "cópula", "vi": "hệ từ", "ko": "계사"}, "difficulty_level": 1110, "sense_prominence": "common"}
{"guid": "N67_003", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "dative", "concept_definition": "A grammatical case that typically marks the indirect object or the recipient, beneficiary, or goal of an action.", "translations": {"en": "dative", "lt": "naudininkas", "zh": "与格", "fr": "datif", "es": "dativo", "es-419": "dativo", "de": "Dativ", "it": "dativo", "pt": "caso dativo", "vi": "cách tặng", "ko": "여격"}, "difficulty_level": 1110, "sense_prominence": "very_common"}
{"guid": "N67_004", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "determiner", "concept_definition": "A word or grammatical element that comes before a noun phrase and identifies, limits, or quantifies the noun, such as “the,” “a,” “this,” “my,” or “some.”", "translations": {"en": "determiner", "lt": "determinantas", "zh": "限定词", "fr": "déterminant", "es": "determinante", "es-419": "determinante", "de": "Determinator", "it": "determinante", "pt": "determinante", "vi": "từ hạn định", "ko": "한정사"}, "difficulty_level": 1110, "sense_prominence": "very_common"}
{"guid": "N67_005", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "dialect", "concept_definition": "A form of a language characteristic of a particular region, social group, or community, differing in vocabulary, grammar, or pronunciation from other forms of the same language.", "translations": {"en": "dialect", "lt": "tarmė", "zh": "方言", "fr": "dialecte", "es": "dialecto", "es-419": "dialecto", "de": "Dialekt", "it": "dialetto", "pt": "dialeto", "vi": "phương ngữ", "ko": "방언"}, "difficulty_level": 329, "sense_prominence": "very_common"}
{"guid": "N67_006", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "diphthong", "concept_definition": "A speech sound in which the tongue or other speech organs move from one vowel position to another within a single syllable.", "translations": {"en": "diphthong", "lt": "dvibalsis", "zh": "双元音", "fr": "diphtongue", "es": "diptongo", "es-419": "diptongo", "de": "Diphthong", "it": "dittongo", "pt": "ditongo", "vi": "nguyên âm đôi", "ko": "이중모음"}, "difficulty_level": 1110, "sense_prominence": "very_common"}
{"guid": "N67_007", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "homonym", "concept_definition": "A word that has the same spelling or pronunciation as another word but a different meaning, such as “bank” meaning a financial institution and “bank” meaning the side of a river.", "translations": {"en": "homonym", "lt": "homonimas", "zh": "同音词", "fr": "homonyme", "es": "homónimo", "es-419": "homónimo", "de": "Homonym", "it": "omonimo", "pt": "homónimo", "vi": "từ đồng âm khác nghĩa", "ko": "동음이의어"}, "difficulty_level": 1110, "sense_prominence": "very_common"}
{"guid": "N67_008", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "lexeme", "concept_definition": "An abstract vocabulary unit that includes all the grammatical forms and inflected variants associated with it, such as “run,” “runs,” “ran,” and “running.”", "translations": {"en": "lexeme", "lt": "leksema", "zh": "词位", "fr": "lexème", "es": "lexema", "es-419": "lexema", "de": "Lexem", "it": "lessema", "pt": "lexema", "vi": "hình vị từ vựng", "ko": "어휘소"}, "difficulty_level": 1110, "sense_prominence": "common"}
