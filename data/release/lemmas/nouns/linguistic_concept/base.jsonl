{"guid": "N67_057", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "lingua franca", "concept_definition": "A language used as a common means of communication between people who speak different native languages.", "translations": {"en": "lingua franca", "lt": "lingua franca", "zh": "通用语", "fr": "lingua franca", "es": "lengua franca", "es-419": "lengua franca"}, "difficulty_level": 1110, "sense_prominence": "very_common"}
{"guid": "N67_058", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "imagery", "concept_definition": "The use of vivid or figurative language that creates mental pictures or evokes sensory experiences, especially in literature.", "translations": {"en": "imagery", "lt": "vaizdingumas", "zh": "意象", "fr": "imagerie", "es": "imaginería", "es-419": "imaginería"}, "difficulty_level": 1110, "sense_prominence": "very_common"}
