{"guid": "N67_011", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "noun", "concept_definition": "A word that names a person, place, thing, idea, quality, or activity and can typically function as the subject or object of a sentence.", "translations": {"en": "noun", "lt": "daiktavardis", "zh": "名词", "fr": "nom", "es": "sustantivo", "es-419": "sustantivo", "de": "Substantiv", "it": "sostantivo", "pt": "substantivo", "vi": "danh từ", "ko": "명사"}, "difficulty_level": 329, "sense_prominence": "very_common"}
{"guid": "N67_012", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "sonorant", "concept_definition": "A speech sound produced with the vocal tract relatively open, allowing continuous airflow and typically functioning as the nucleus of a syllable; vowels, nasals, liquids, and glides are sonorants.", "translations": {"en": "sonorant", "lt": "sonorantas", "zh": "响音", "fr": "sonorante", "es": "sonorante", "es-419": "sonorante", "de": "Sonorant", "it": "sonorante", "pt": "soante", "vi": "âm vang", "ko": "공명음"}, "difficulty_level": 1110, "sense_prominence": "common"}
