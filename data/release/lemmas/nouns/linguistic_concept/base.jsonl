{"guid": "N67_076", "pos_type": "noun", "pos_subtype": "linguistic_concept", "concept_label": "imperative", "concept_definition": "The grammatical mood used to express commands, requests, or instructions.", "translations": {"en": "imperative", "lt": "liepiamoji nuosaka", "zh": "祈使语气", "fr": "impératif", "es": "imperativo", "es-419": "imperativo"}, "difficulty_level": 1110, "sense_prominence": "common"}
