{"guid": "N11_091", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "coastline", "concept_definition": "The boundary where land meets the sea; the outline or strip of land along a coast.", "translations": {"en": "coastline", "lt": "pakrantė", "zh": "海岸线", "fr": "littoral", "es": "línea costera", "es-419": "línea costera"}, "difficulty_level": 1020, "sense_prominence": "very_common"}
{"guid": "N11_092", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "tributary", "concept_definition": "A river or stream that flows into a larger river, lake, or other body of water.", "translations": {"en": "tributary", "lt": "intakas", "zh": "支流", "fr": "affluent", "es": "afluente", "es-419": "afluente"}, "difficulty_level": 1020, "sense_prominence": "very_common"}
{"guid": "N11_093", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "confluence", "concept_definition": "The place where two or more rivers, streams, or other flowing bodies of water meet and join.", "translations": {"en": "confluence", "lt": "santaka", "zh": "汇流处", "fr": "confluence", "es": "confluencia", "es-419": "confluencia"}, "difficulty_level": 1020, "sense_prominence": "very_common"}
{"guid": "N11_094", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "snowfall", "concept_definition": "The amount of snow that falls during a particular time or storm.", "translations": {"en": "snowfall", "lt": "sniegas", "zh": "降雪", "fr": "chute de neige", "es": "nevada", "es-419": "nevada"}, "difficulty_level": 1020, "sense_prominence": "very_common"}
{"guid": "N11_095", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "shoreline", "concept_definition": "The line where a body of water meets the land; the edge of a sea, lake, river, or other water body.", "translations": {"en": "shoreline", "lt": "pakrantė", "zh": "海岸线", "fr": "ligne de rivage", "es": "línea costera", "es-419": "línea costera"}, "difficulty_level": 1020, "sense_prominence": "very_common"}
{"guid": "N11_096", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "galaxy", "concept_definition": "A vast system of stars, gas, dust, and dark matter held together by gravity, such as the Milky Way.", "translations": {"en": "galaxy", "lt": "galaktika", "zh": "星系", "fr": "galaxie", "es": "galaxia", "es-419": "galaxia"}, "difficulty_level": 1050, "sense_prominence": "very_common"}
{"guid": "N11_097", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "supernova", "concept_definition": "A powerful stellar explosion in which a star suddenly becomes vastly brighter and then gradually fades, often leaving behind a neutron star or black hole.", "translations": {"en": "supernova", "lt": "supernova", "zh": "超新星", "fr": "supernova", "es": "supernova", "es-419": "supernova"}, "difficulty_level": 1050, "sense_prominence": "very_common"}
{"guid": "N11_098", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "supernova", "concept_definition": "A star that undergoes a supernova explosion, especially when referring to it as a transient astronomical object.", "translations": {"en": "supernova", "lt": "supernovos žvaigždė", "zh": "超新星", "fr": "étoile supernova", "es": "estrella supernova", "es-419": "estrella supernova"}, "difficulty_level": 1050, "sense_prominence": "common"}
{"guid": "N11_099", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "magma", "concept_definition": "Molten or partly molten rock beneath the Earth's surface, from which igneous rocks form when it cools.", "translations": {"en": "magma", "lt": "magma", "zh": "岩浆", "fr": "magma", "es": "magma", "es-419": "magma"}, "difficulty_level": 1050, "sense_prominence": "very_common"}
{"guid": "N11_100", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "asteroid", "concept_definition": "A small rocky or metallic celestial body that orbits the Sun, especially one found between the orbits of Mars and Jupiter.", "translations": {"en": "asteroid", "lt": "asteroidas", "zh": "小行星", "fr": "astéroïde", "es": "asteroide", "es-419": "asteroide"}, "difficulty_level": 1050, "sense_prominence": "very_common"}
{"guid": "N11_101", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "lithosphere", "concept_definition": "The rigid outer layer of Earth, consisting of the crust and the uppermost solid mantle, and lying above the softer asthenosphere.", "translations": {"en": "lithosphere", "lt": "litosfera", "zh": "岩石圈", "fr": "lithosphère", "es": "litosfera", "es-419": "litosfera"}, "difficulty_level": 1050, "sense_prominence": "very_common"}
{"guid": "N11_102", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "vortex", "concept_definition": "A mass of air, water, or another fluid that spins rapidly around a central point, often forming a whirling column or spiral.", "translations": {"en": "vortex", "lt": "sūkurys", "zh": "漩涡", "fr": "tourbillon", "es": "vórtice", "es-419": "vórtice"}, "difficulty_level": 1050, "sense_prominence": "very_common"}
{"guid": "N11_103", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "jungle", "concept_definition": "A dense tropical forest, especially one with thick tangled vegetation.", "translations": {"en": "jungle", "lt": "džiunglės", "zh": "丛林", "fr": "jungle", "es": "jungla", "es-419": "selva"}, "difficulty_level": 219, "sense_prominence": "very_common"}
{"guid": "N11_104", "pos_type": "noun", "pos_subtype": "natural_feature", "concept_label": "channel", "concept_definition": "A long, narrow passage through which water flows, especially a natural or artificial waterway.", "translations": {"en": "channel", "lt": "kanalas", "zh": "水道", "fr": "canal", "es": "canal", "es-419": "canal"}, "difficulty_level": 219, "sense_prominence": "very_common"}
