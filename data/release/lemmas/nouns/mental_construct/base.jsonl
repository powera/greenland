{"guid": "N20_001", "pos_type": "noun", "pos_subtype": "mental_construct", "concept_label": "mind", "concept_definition": "the element of a person that thinks, perceives, feels, and wills; the conscious mental processes or intellect", "translations": {"en": "mind", "lt": "protas", "zh": "心智", "fr": "esprit", "es": "mente", "de": "Geist", "it": "mente", "nl": "geest", "pt": "mente", "sv": "sinne", "vi": "tâm trí", "ja": "心", "ko": "마음", "sw": "akili"}, "difficulty_level": 16}
