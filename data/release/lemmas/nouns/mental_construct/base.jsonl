{"guid": "N20_005", "pos_type": "noun", "pos_subtype": "mental_construct", "concept_label": "sense", "concept_definition": "a faculty by which stimuli from outside or inside the body are perceived (e.g., sight, hearing, touch); a feeling or perception produced in the mind by something external or internal; practical awareness or understanding of a situation or fact (e.g., a sense of urgency).", "translations": {"en": "sense", "lt": "jutimas", "zh": "感覺", "fr": "sens", "es": "sentido", "de": "Sinn", "it": "senso", "nl": "zintuig", "pt": "sentido", "sv": "sinne", "vi": "giác quan", "ja": "感覚", "ko": "감각", "sw": "hisi"}, "difficulty_level": 16}
