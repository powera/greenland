{"guid": "N66_080", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "statistic", "concept_definition": "A numerical value calculated from sample data, such as a mean or proportion, and used to summarize the sample or estimate a population characteristic.", "translations": {"en": "statistic", "lt": "statistika", "zh": "统计量", "fr": "statistique", "es": "estadístico", "es-419": "estadístico"}, "difficulty_level": 1080, "sense_prominence": "common"}
