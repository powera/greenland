{"guid": "N66_083", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "theorem", "concept_definition": "A statement or proposition that has been proved to be true, especially by reasoning from established facts or axioms.", "translations": {"en": "theorem", "lt": "teorema", "zh": "定理", "fr": "théorème", "es": "teorema", "es-419": "teorema"}, "difficulty_level": 1080, "sense_prominence": "very_common"}
