{"guid": "N66_094", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "remainder", "concept_definition": "The amount left over after one number is divided by another, when the division does not come out evenly.", "translations": {"en": "remainder", "lt": "liekana", "zh": "余数", "fr": "reste", "es": "residuo", "es-419": "residuo"}, "difficulty_level": 380, "sense_prominence": "common"}
{"guid": "N66_095", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "transformation", "concept_definition": "A change in the form or position of a mathematical expression, figure, or coordinate system according to a specified rule.", "translations": {"en": "transformation", "lt": "transformacija", "zh": "变换", "fr": "transformation", "es": "transformación", "es-419": "transformación"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_096", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "integral", "concept_definition": "A mathematical function whose derivative is a specified function, or the result of calculating the integral of a function.", "translations": {"en": "integral", "lt": "integralas", "zh": "积分", "fr": "intégrale", "es": "integral", "es-419": "integral"}, "difficulty_level": 1080, "sense_prominence": "common"}
