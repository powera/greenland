{"guid": "N66_085", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "vector", "concept_definition": "A quantity or object that has both magnitude and direction, commonly represented by an arrow or by a list of components.", "translations": {"en": "vector", "lt": "vektorius", "zh": "向量", "fr": "vecteur", "es": "vector", "es-419": "vector"}, "difficulty_level": 1080, "sense_prominence": "very_common"}
{"guid": "N66_086", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "vector", "concept_definition": "A quantity specifying the magnitude and direction of a physical force, velocity, or other measurable property.", "translations": {"en": "vector", "lt": "vektorius", "zh": "矢量", "fr": "vecteur", "es": "vector", "es-419": "vector"}, "difficulty_level": 1058, "sense_prominence": "common"}
{"guid": "N66_087", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "fraction", "concept_definition": "A numerical quantity that represents part of a whole, usually written as one number over another, as in 3/4.", "translations": {"en": "fraction", "lt": "trupmena", "zh": "分数", "fr": "fraction", "es": "fracción", "es-419": "fracción"}, "difficulty_level": 1085, "sense_prominence": "very_common"}
{"guid": "N66_088", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "operator", "concept_definition": "A symbol or function that specifies an operation to be performed on one or more values, as in mathematics or computing.", "translations": {"en": "operator", "lt": "operatorius", "zh": "运算符", "fr": "opérateur", "es": "operador", "es-419": "operador"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_089", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "diameter", "concept_definition": "A straight line segment passing through the center of a circle or sphere and joining two points on its circumference or surface; also, the length of that segment.", "translations": {"en": "diameter", "lt": "skersmuo", "zh": "直径", "fr": "diamètre", "es": "diámetro", "es-419": "diámetro"}, "difficulty_level": 380, "sense_prominence": "very_common"}
{"guid": "N66_090", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "domain", "concept_definition": "The set of all possible input values for a function.", "translations": {"en": "domain", "lt": "apibrėžimo sritis", "zh": "定义域", "fr": "domaine de définition", "es": "dominio", "es-419": "dominio"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_091", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "equation", "concept_definition": "A mathematical statement that two expressions or quantities are equal, usually written with an equals sign.", "translations": {"en": "equation", "lt": "lygtis", "zh": "方程", "fr": "équation", "es": "ecuación", "es-419": "ecuación"}, "difficulty_level": 1080, "sense_prominence": "very_common"}
{"guid": "N66_092", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "minimum", "concept_definition": "The lowest value of a variable or function, especially the lowest value reached over a specified interval or set.", "translations": {"en": "minimum", "lt": "minimumas", "zh": "最小值", "fr": "minimum", "es": "mínimo", "es-419": "mínimo"}, "difficulty_level": 380, "sense_prominence": "common"}
