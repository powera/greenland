{"guid": "N66_076", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "perpendicular", "concept_definition": "A line or plane that is perpendicular to another line or plane; especially, a line meeting another at a right angle.", "translations": {"en": "perpendicular", "lt": "statmuo", "zh": "垂线", "fr": "perpendiculaire", "es": "perpendicular", "es-419": "perpendicular"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_077", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "radius", "concept_definition": "A straight line from the center of a circle or sphere to its edge; also, the length of that line.", "translations": {"en": "radius", "lt": "spindulys", "zh": "半径", "fr": "rayon", "es": "radio", "es-419": "radio"}, "difficulty_level": 1080, "sense_prominence": "very_common"}
