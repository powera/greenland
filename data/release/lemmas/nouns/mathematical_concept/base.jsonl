{"guid": "N66_048", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "helix", "concept_definition": "A three-dimensional curve that winds around an axis at a constant or steadily changing distance from it, like a spiral staircase or a spring.", "translations": {"en": "helix", "lt": "sraigtinė linija", "zh": "螺旋线", "fr": "hélice", "es": "hélice", "es-419": "hélice"}, "difficulty_level": 1085, "sense_prominence": "common"}
{"guid": "N66_049", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "formula", "concept_definition": "A prescribed or established set of words, symbols, or steps used to express a rule, explain a relationship, or solve a problem, especially in mathematics or science.", "translations": {"en": "formula", "lt": "formulė", "zh": "公式", "fr": "formule", "es": "fórmula", "es-419": "fórmula"}, "difficulty_level": 380, "sense_prominence": "very_common"}
{"guid": "N66_050", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "mode", "concept_definition": "The value that occurs most frequently in a set of data.", "translations": {"en": "mode", "lt": "moda", "zh": "众数", "fr": "mode", "es": "moda", "es-419": "moda"}, "difficulty_level": 1399, "sense_prominence": "common"}
{"guid": "N66_051", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "probability", "concept_definition": "A measure or mathematical theory of random events and their likelihoods.", "translations": {"en": "probability", "lt": "tikimybių teorija", "zh": "概率论", "fr": "probabilités", "es": "probabilidad", "es-419": "probabilidad"}, "difficulty_level": 380, "sense_prominence": "common"}
{"guid": "N66_052", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "proof", "concept_definition": "A rigorous demonstration that a mathematical statement follows from established assumptions or results.", "translations": {"en": "proof", "lt": "įrodymas", "zh": "证明", "fr": "démonstration", "es": "demostración", "es-419": "demostración"}, "difficulty_level": 380, "sense_prominence": "common"}
{"guid": "N66_053", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "proportion", "concept_definition": "A relationship between quantities in which one quantity varies according to another, especially a mathematical ratio.", "translations": {"en": "proportion", "lt": "proporcija", "zh": "比例式", "fr": "proportion", "es": "proporción", "es-419": "proporción"}, "difficulty_level": 380, "sense_prominence": "common"}
{"guid": "N66_054", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "sequence", "concept_definition": "A set of mathematical objects, usually numbers, arranged in a specified order and often generated according to a rule.", "translations": {"en": "sequence", "lt": "seka", "zh": "数列", "fr": "suite", "es": "sucesión", "es-419": "sucesión"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_055", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "sum", "concept_definition": "The result obtained by adding two or more numbers or quantities.", "translations": {"en": "sum", "lt": "suma", "zh": "和", "fr": "somme", "es": "suma", "es-419": "suma"}, "difficulty_level": 380, "sense_prominence": "very_common"}
{"guid": "N66_056", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "proportionality", "concept_definition": "A mathematical relationship in which two quantities vary in a fixed ratio, or in which one quantity varies directly or inversely with another.", "translations": {"en": "proportionality", "lt": "proporcingumas", "zh": "正比例关系", "fr": "proportionnalité", "es": "proporcionalidad", "es-419": "proporcionalidad"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_057", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "gradient", "concept_definition": "A rate of change of a quantity with respect to distance or another variable; in mathematics, especially, the vector of partial derivatives of a scalar-valued function.", "translations": {"en": "gradient", "lt": "gradientas", "zh": "梯度", "fr": "gradient", "es": "gradiente", "es-419": "gradiente"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_058", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "arithmetic", "concept_definition": "A calculation or set of calculations using the basic operations of arithmetic; the result of such calculation.", "translations": {"en": "arithmetic", "lt": "skaičiavimas", "zh": "计算", "fr": "calcul", "es": "cálculo", "es-419": "cálculo"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_059", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "calculus", "concept_definition": "A method or system of calculation or reasoning, especially one involving formal rules or symbolic operations.", "translations": {"en": "calculus", "lt": "skaičiavimas", "zh": "计算", "fr": "calcul", "es": "cálculo", "es-419": "cálculo"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_060", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "coefficient", "concept_definition": "A numerical or algebraic factor that multiplies a variable or another expression; for example, in 5x, 5 is the coefficient of x.", "translations": {"en": "coefficient", "lt": "koeficientas", "zh": "系数", "fr": "coefficient", "es": "coeficiente", "es-419": "coeficiente"}, "difficulty_level": 1080, "sense_prominence": "very_common"}
{"guid": "N66_061", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "coordinate", "concept_definition": "A number or group of numbers that specifies the position of a point in a system, such as a map or graph.", "translations": {"en": "coordinate", "lt": "koordinatė", "zh": "坐标", "fr": "coordonnée", "es": "coordenada", "es-419": "coordenada"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_062", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "correlation", "concept_definition": "A statistical relationship between two variables, measured by how consistently they vary together; the relationship may be positive, negative, or absent.", "translations": {"en": "correlation", "lt": "koreliacija", "zh": "相关关系", "fr": "corrélation", "es": "correlación", "es-419": "correlación"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_063", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "curvature", "concept_definition": "In mathematics, a quantity that measures how much a curve or surface departs from being straight or flat at a point.", "translations": {"en": "curvature", "lt": "kreivumas", "zh": "曲率", "fr": "courbure", "es": "curvatura", "es-419": "curvatura"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_064", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "denominator", "concept_definition": "The number written below the line in a fraction, showing how many equal parts make up a whole.", "translations": {"en": "denominator", "lt": "vardiklis", "zh": "分母", "fr": "dénominateur", "es": "denominador", "es-419": "denominador"}, "difficulty_level": 1080, "sense_prominence": "very_common"}
{"guid": "N66_065", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "derivative", "concept_definition": "A function that gives the rate at which another function changes with respect to its variable; more generally, a quantity obtained by differentiating a function.", "translations": {"en": "derivative", "lt": "išvestinė", "zh": "导数", "fr": "dérivée", "es": "derivada", "es-419": "derivada"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_066", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "differentiation", "concept_definition": "The mathematical operation of finding a derivative, or the result of carrying out that operation.", "translations": {"en": "differentiation", "lt": "diferencijavimas", "zh": "求导", "fr": "dérivation", "es": "derivación", "es-419": "derivación"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_067", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "equivalence", "concept_definition": "A relation between mathematical expressions, propositions, or sets that have the same value or are true under the same conditions.", "translations": {"en": "equivalence", "lt": "ekvivalentiškumas", "zh": "等价关系", "fr": "équivalence", "es": "equivalencia", "es-419": "equivalencia"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_068", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "inequality", "concept_definition": "A mathematical statement that one quantity is greater than or less than another, rather than equal to it.", "translations": {"en": "inequality", "lt": "nelygybė", "zh": "不等式", "fr": "inégalité", "es": "desigualdad", "es-419": "desigualdad"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_069", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "integer", "concept_definition": "A whole number, positive, negative, or zero, that has no fractional or decimal part.", "translations": {"en": "integer", "lt": "sveikasis skaičius", "zh": "整数", "fr": "entier", "es": "entero", "es-419": "entero"}, "difficulty_level": 1080, "sense_prominence": "very_common"}
{"guid": "N66_070", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "inverse", "concept_definition": "A number or quantity that, when combined with another by a specified operation, gives the identity element for that operation; for multiplication, the reciprocal.", "translations": {"en": "inverse", "lt": "atvirkštinis elementas", "zh": "逆元", "fr": "inverse", "es": "inverso", "es-419": "inverso"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_071", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "inverse", "concept_definition": "A function that reverses the effect of another function, returning an input from its output.", "translations": {"en": "inverse", "lt": "atvirkštinė funkcija", "zh": "反函数", "fr": "fonction réciproque", "es": "función inversa", "es-419": "función inversa"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_072", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "lattice", "concept_definition": "A regular arrangement of points, atoms, or other elements in space, especially the repeating pattern of atoms in a crystal.", "translations": {"en": "lattice", "lt": "gardelės", "zh": "晶格", "fr": "réseau cristallin", "es": "red cristalina", "es-419": "red cristalina"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_073", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "mapping", "concept_definition": "A correspondence or assignment that associates each element in one set, space, or system with an element in another; also, the rule or function that makes this assignment.", "translations": {"en": "mapping", "lt": "atvaizdis", "zh": "映射", "fr": "correspondance", "es": "correspondencia", "es-419": "correspondencia"}, "difficulty_level": 1080, "sense_prominence": "common"}
{"guid": "N66_074", "pos_type": "noun", "pos_subtype": "mathematical_concept", "concept_label": "matrix", "concept_definition": "A rectangular arrangement of numbers, symbols, or other elements in rows and columns, treated as a single mathematical object.", "translations": {"en": "matrix", "lt": "matrica", "zh": "矩阵", "fr": "matrice", "es": "matriz", "es-419": "matriz"}, "difficulty_level": 1080, "sense_prominence": "common"}
