{"guid": "V14_001", "pos_type": "verb", "pos_subtype": "rule_defined_action", "concept_label": "castle (chess)", "concept_definition": "In chess, to move the king two squares toward a rook and then move that rook to the square the king crossed, as one move.", "translations": {"en": "castle", "lt": "rokiruoti", "zh": "王车易位", "fr": "roquer", "es": "enrocar", "es-419": "enrocar"}, "difficulty_level": 1202, "disambiguation": {"en": "chess"}, "sense_prominence": "rare"}
