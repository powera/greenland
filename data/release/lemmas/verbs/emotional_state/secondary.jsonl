{"guid": "V05_001", "translations": {"ro": "plăcea", "pl": "lubić", "th": "ชอบ", "ta": "பிடிக்க", "kn": "ಇಷ್ಟಪಡು", "uk": "подобатися", "bn": "পছন্দ করা", "hi": "पसंद करना"}}
{"guid": "V05_002", "translations": {"ro": "iubi", "pl": "kochać", "th": "รัก", "ta": "காதலிப்பது", "kn": "ಪ್ರೇಮಿಸು", "uk": "любити", "bn": "ভালবাসা", "hi": "प्यार करना"}}
{"guid": "V05_003", "translations": {"ro": "urăi", "pl": "nienawidzić", "th": "เกลียด", "ta": "மிக விரோதத்துடன் வெறுக்க", "kn": "ದ್ವೇಷಿಸು", "uk": "ненавидіти", "bn": "ঘৃণা করা", "hi": "घृणा करना"}}
{"guid": "V05_004", "translations": {"ro": "dori", "pl": "chcieć", "th": "ต้องการ", "ta": "விரும்பு", "kn": "ಇಷ್ಟಪಟ್ಟು/ಇಚ್ಛೆಪಡುವ (ಇಚ್ಛಿಸುವ)", "uk": "бажати", "bn": "চাওয়া", "hi": "चाहना"}}
{"guid": "V05_005", "translations": {"ro": "simți", "pl": "czuć", "th": "รู้สึก", "ta": "அனுபவிக்க", "kn": "ಅನುಭವಿಸು", "uk": "відчувати", "bn": "অনুভব করা", "hi": "अनुभव करना"}}
{"guid": "V05_006", "translations": {"ro": "plânge", "pl": "płakać", "th": "ร้องไห้", "ta": "அருந்துதல்", "kn": "ಕೊಳೆಯುವುದು", "uk": "плакати", "bn": "কাঁদা", "hi": "रोना"}}
{"guid": "V05_007", "translations": {"ro": "zâmbi", "pl": "uśmiechać", "th": "ยิ้ม", "ta": "புலம்திரித்தல்", "kn": "ನಗೆಸಲು", "uk": "посміхатися", "bn": "হাসা", "hi": "मुस्कुराना"}}
{"guid": "V05_008", "translations": {"ro": "dori", "pl": "tęsknić", "th": "โหยหา", "ta": "புனர்மலர்ச்சி கொள்வது", "kn": "ಸ್ಮರಿಸು", "uk": "сумувати", "bn": "বিরহবোধ করা", "hi": "veerana"}}
{"guid": "V05_009", "translations": {"ro": "îngrijora", "pl": "martwić się", "th": "เป็นกังวล", "ta": "கவலைபடு", "kn": "ಚಿಂತಿಸು", "uk": "хвилюватися", "bn": "চিন্তা করা", "hi": "चिंतित होना"}}
{"guid": "V05_010", "translations": {"ro": "râde", "pl": "śmiać się", "th": "หัวเราะ", "ta": "சிரிக்க", "kn": "ನಕ್ಕು/ನಕ್ಕುನು (Note: Kannada verb infinitive typically 'ನಕ್ಕುವುದು' but lemma often given as 'ನಕ್ಕು')", "uk": "сміятися", "bn": "হাসা", "hi": "हँसना"}}
{"guid": "V05_011", "translations": {"ro": "spera", "pl": "mieć nadzieję", "th": "หวัง", "ta": "நம்பிஞ்சிக்கொள்ள", "kn": "ಆಶಾವಹಿಸು", "uk": "сподіватися", "bn": "আশা করা", "hi": "आशा करना"}}
{"guid": "V05_012", "translations": {"ro": "a se teme", "pl": "bać się", "th": "กลัว", "ta": "பயப்படுவது", "kn": "ಭಯಪಡಲು", "uk": "бояться", "bn": "ভয় পাওয়া", "hi": "डरना"}}
{"guid": "V05_013", "translations": {"ro": "bucura-se", "pl": "cieszyć się", "th": "เพลิดเพลิน", "ta": "ஆனந்தம் படு", "kn": "ಆನಂದಿಸು", "uk": "насолоджуватися", "bn": "আনন্দ নেওয়া", "hi": "आनंद लेना"}}
{"guid": "V05_014", "translations": {"ro": "suferi", "pl": "cierpieć", "th": "ทนทุกข์", "ta": "வலிச்செறிவதற்கு", "kn": "ವേദನೆ ಪಡಲು", "uk": "страждати", "bn": "কষ্ট ভোগ করা", "hi": "कश्टि भोगना"}}
{"guid": "V05_015", "translations": {"ro": "surprinde", "pl": "zaskoczyć", "th": "ทำให้ประหลาดใจ", "ta": "ஆச்சரியப்படுத்து", "kn": "ಅಚ್ಚರಿಗೊಳಿಸು", "uk": "здивувати", "bn": "আশ্চর্য করা", "hi": "आश्चर्यचकित करना"}}
{"guid": "V05_016", "translations": {"ro": "avea încredere", "pl": "ufać", "th": "เชื่อใจ", "ta": "நம்பிக்கை வைக்க", "kn": "ನಂಬು", "uk": "довіряти", "bn": "বিশ্বাস করা", "hi": "विश्वास करना"}}
{"guid": "V05_017", "translations": {"ro": "a prefera", "pl": "preferować", "th": "ให้ความสำคัญ", "ta": "முன்னுரிமை கொடு", "kn": "ಪ್ರಾಧಾನ್ಯವನ್ನು ನೀಡು", "uk": "надавати перевагу", "bn": "অগ্রাধিকার দেওয়া", "hi": "प्राथमिकता देना"}}
{"guid": "V05_018", "translations": {"ro": "regreta", "pl": "żałować", "th": "เสียใจ", "ta": "பிப்ரமிப்பு", "kn": "ಕ್ಷಮಿಸುವುದು", "uk": "шкодувати", "bn": "অনুতপ্ত হওয়া", "hi": "अफ़सोस करना"}}
{"guid": "V05_019", "translations": {"ro": "îngriji", "pl": "troszczyć się", "th": "ห่วงใย", "ta": "புகங் கரவு", "kn": "ಪರಿಶ್ರಾಮಿಸು", "uk": "турбуватися", "bn": "ভেবেচিন্তা করা", "hi": "परवाह करना"}}
{"guid": "V05_020", "translations": {"ro": "iertă", "pl": "wybaczyć", "th": "ให้อภัย", "ta": "மன்னிப்பு கூறு", "kn": "ಕ್ಷಮಿಸು", "uk": "прощати", "bn": "ক্ষমা করা", "hi": "माफ़ करना"}}
{"guid": "V05_021", "translations": {"ro": "admira", "pl": "podziwiać", "th": "ชื่นชม", "ta": "புகழ் கொடுக்க", "kn": "ಪ್ರಶಂಸಿಸು", "uk": "захоплюватися", "bn": "প্রশংসা করা", "hi": "प्रशंसना"}}
{"guid": "V05_022", "translations": {"ro": "invidia", "pl": "zazdrościć", "th": "อิจฉา", "ta": "பொறாமைப்படுவது", "kn": "ಹಿಂಸೆಪಡುವುದು", "uk": "заздрити", "bn": "ঈর্ষা করা", "hi": "ईर्ष्या करना"}}
{"guid": "V05_023", "translations": {"ro": "bârlfăi", "pl": "znudzić", "th": "เบื่อหน่าย", "ta": "பிச்சைக்கரைப்படுத்துதல்", "kn": "ಬೆರೆಸಲು", "uk": "надокучувати", "bn": "বিরক্ত করা", "hi": "उबाऊ करना"}}
