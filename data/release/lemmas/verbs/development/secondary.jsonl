{"guid": "V07_001", "translations": {"ro": "instrui", "pl": "trenować", "th": "ฝึกสอน", "ta": "பயிற்பِடுத்து", "kn": "ಪ್ರಶಿಕ್ಷಣ ನೀಡು", "uk": "тренувати", "bn": "প্রশিক্ষণ দেওয়া", "hi": "प्रशिक्षण देना"}}
{"guid": "V07_002", "translations": {"ro": "dezvolta", "pl": "rozwijać", "th": "พัฒนา", "ta": "வான்ச்சி/விருத்தி செய்ய", "kn": "ವಿಕಸಿಸು", "uk": "розвивати", "bn": "উন্নয়ন করা", "hi": "विकसित करना"}}
{"guid": "V07_003", "translations": {"ro": "îmbunătăți", "pl": "poprawiać", "th": "ปรับปรุง", "ta": "மேம்படுத்து", "kn": "ಮೇರುಗೊಳಿಸು", "uk": "покращувати", "bn": "উন্নত করা", "hi": "सुधारना"}}
{"guid": "V07_004", "translations": {"ro": "exersa", "pl": "ćwiczyć", "th": "ฝึกฝน", "ta": "பயிற்சி செய்", "kn": "ಅಭ್ಯಾಸ ಮಾಡು", "uk": "практикувати", "bn": "অভ্যাস করা", "hi": "अभ्यास करना"}}
{"guid": "V07_005", "translations": {"ro": "progresa", "pl": "postępować", "th": "ดำเนินความก้าวหน้า", "ta": "முன்னேறுதல்", "kn": "ಮುಂದೆ ಸರವು (ಮುಂದೆಸರು isn't correct?)", "uk": "просуватися", "bn": "উন্নতি করা", "hi": "प्रगति करना"}}
{"guid": "V07_006", "translations": {"ro": "matura", "pl": "dojrzeć", "th": "เจริญเติบโต", "ta": "பெருக்க தயாராகு", "kn": "ಪ್ರೋತ್ಸಾಹಿಸು", "uk": "дозріти", "bn": "পক্ক হওয়া", "hi": "परिपक्व होना"}}
{"guid": "V07_007", "translations": {"ro": "evolua", "pl": "ewoluować", "th": "วิวัฒนาการ", "ta": "மிருதுவாக வளர்ச்சி அடைய", "kn": "ಉದ್ಭವಿಸು", "uk": "розвиватися", "bn": "উন্নতি হওয়া", "hi": "विकसित होना"}}
{"guid": "V07_008", "translations": {"ro": "pregăti", "pl": "przygotować", "th": "เตรียม", "ta": "தயார் செய்ய", "kn": "ಮಾಡಲು ಸಿದ್ಧಪಡಿಸು", "uk": "підготувати", "bn": "প্রস্তুত করা", "hi": "तैयार करना"}}
{"guid": "V07_009", "translations": {"ro": "educa", "pl": "kształcić", "th": "ให้การศึกษา", "ta": "கல்வியளிக்க", "kn": "ಶಿಕ್ಷಣ ನೀಡಲು", "uk": "освічувати", "bn": "শিক্ষা দেওয়া", "hi": "शिक्षित करना"}}
{"guid": "V07_010", "translations": {"ro": "întări", "pl": "wzmacniać", "th": "เสริมความแข็งแรง", "ta": "வலுப்படுத்த", "kn": "ವಾಗಿಸು", "uk": "зміцнити", "bn": "শক্তিশালী করা", "hi": "मजबूत करना"}}
{"guid": "V07_011", "translations": {"ro": "cultiva", "pl": "pielęgnować", "th": "ดูแลเอาใจใส่", "ta": "பராமரிக்க", "kn": "ಪೋಷಣೆ ಮಾಡು", "uk": "доглядати", "bn": "পালন করা", "hi": "पालन करना"}}
{"guid": "V07_012", "translations": {"ro": "cultiva", "pl": "kultywować", "th": "ปลูกฝัง", "ta": "பழகப்படுத்த", "kn": "ಬೆಳೆಸಲು", "uk": "розвивати", "bn": "চানানো", "hi": "पालन-पोषण करना"}}
{"guid": "V07_013", "translations": {"ro": "avansa", "pl": "posuwać się naprzód", "th": "ก้าวหน้า", "ta": "முன்னேறல்", "kn": "ಮುಂದಕ್ಕೆ ನಡುಗಲು", "uk": "просуватися", "bn": "অগ্রসর হওয়া", "hi": "आगे बढ़ना"}}
{"guid": "V07_014", "translations": {"ro": "perfecționa", "pl": "udoskonalić", "th": "ปรับปรุง", "ta": "மேம்படுத்து", "kn": "ಸुधಾರಿಸು", "uk": "удосконалити", "bn": "সংশোধন করা", "hi": "सुधारना"}}
{"guid": "V07_015", "translations": {"ro": "înflori", "pl": "kwitnąć", "th": "เจริญเติบโต", "ta": "மெழுன்", "kn": "ಕುਸ਼ಲತೆ ಹೊಂದು", "uk": "процвітати", "bn": "ফুলে উঠা", "hi": "समृद्ध होना"}}
{"guid": "V07_016", "translations": {"ro": "crește", "pl": "wychowywać", "th": "เลี้ยงดู", "ta": "பகல்வது", "kn": "ಬೆಳೆಸಲು", "uk": "вирощувати", "bn": "পালন করা", "hi": "पालन करना"}}
