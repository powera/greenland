{"guid": "A02_001", "pos_type": "adjective", "pos_subtype": "color", "concept_label": "black", "concept_definition": "Of the very darkest color, the result of the absence or complete absorption of visible light; having a color like that of coal or ink.", "translations": {"en": "black", "lt": "juodas", "zh": "黑色的", "fr": "noir", "es": "negro", "de": "schwarz", "it": "nero", "nl": "zwart", "pt": "preto", "sv": "svart", "vi": "đen", "ja": "黒い", "ko": "검은", "sw": "nyeusi"}, "difficulty_level": 3}
