{"guid": "D16_014", "pos_type": "adverb", "pos_subtype": "connective", "concept_label": "thereby", "concept_definition": "As a result of that; consequently.", "translations": {"en": "thereby", "lt": "dėl to", "zh": "因此", "fr": "par conséquent", "es": "por ello", "es-419": "por ello"}, "difficulty_level": 1399, "sense_prominence": "common"}
