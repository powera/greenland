{"guid": "D16_001", "pos_type": "adverb", "pos_subtype": "connective", "concept_label": "hence", "concept_definition": "As a result; for this reason.", "translations": {"en": "hence", "lt": "todėl", "zh": "因此", "fr": "par conséquent", "es": "por lo tanto", "es-419": "por lo tanto"}, "difficulty_level": 304, "sense_prominence": "very_common"}
{"guid": "D16_002", "pos_type": "adverb", "pos_subtype": "connective", "concept_label": "nevertheless (linking, time and degree adverbs)", "concept_definition": "In linking adverb use, introduces a statement that contrasts with or is true despite what has just been said.", "translations": {"en": "nevertheless", "lt": "vis dėlto", "zh": "然而", "fr": "néanmoins", "es": "sin embargo", "es-419": "sin embargo"}, "difficulty_level": 227, "disambiguation": {"en": "linking, time and degree adverbs"}, "sense_prominence": "common"}
