#!/bin/bash
#
# Pre-commit hook for greenland-mint.
#   - Checks Python formatting with black (staged src/*.py files).
#   - Checks for duplicate GUIDs in data/release (staged data/release/* files).
#
# To enable this hook, run:
#   git config core.hooksPath hooks

FAILED=0

# --- Black formatting check ---
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '^src/.*\.py$')

if [ -n "$STAGED_PY" ]; then
    if ! command -v black &> /dev/null; then
        echo "Error: black is not installed. Install with: pip install black"
        FAILED=1
    else
        echo "Checking Python formatting with black..."
        black --check $STAGED_PY
        if [ $? -ne 0 ]; then
            echo ""
            echo "Some files need formatting. Run:"
            echo "  black $STAGED_PY"
            echo ""
            echo "Or to format all src/ files:"
            echo "  black src/"
            FAILED=1
        else
            echo "All staged Python files are properly formatted."
        fi
    fi
fi

# --- Duplicate GUID check ---
STAGED_RELEASE=$(git diff --cached --name-only --diff-filter=ACM | grep '^data/release/')

if [ -n "$STAGED_RELEASE" ]; then
    echo "Checking for duplicate GUIDs in data/release..."
    python3 scripts/check_duplicate_guids.py
    if [ $? -ne 0 ]; then
        FAILED=1
    fi
fi

exit $FAILED
