#!/bin/bash
#
# Pre-commit hook to check Python formatting with black.
# Only checks staged Python files in src/.
#
# To enable this hook, run:
#   git config core.hooksPath hooks

# Get list of staged Python files in src/
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^src/.*\.py$')

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Check if black is available
if ! command -v black &> /dev/null; then
    echo "Error: black is not installed. Install with: pip install black"
    exit 1
fi

# Run black in check mode on staged files
echo "Checking Python formatting with black..."
black --check $STAGED_FILES
RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "Some files need formatting. Run:"
    echo "  black $STAGED_FILES"
    echo ""
    echo "Or to format all src/ files:"
    echo "  black src/"
    exit 1
fi

echo "All staged Python files are properly formatted."
exit 0
